########################################
# ====== GENERAL ======
########################################

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

########################################
# ====== PYTHON / DJANGO ======
########################################

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Django stuff
*.sqlite3
db.sqlite3
media/
staticfiles/

# Migrations (optional - usually NO se ignoran)
# backend/*/migrations/
# !backend/*/migrations/__init__.py

# Environment variables
.env
.env.*

# Coverage
.coverage
htmlcov/

# Pytest
.pytest_cache/

# MyPy
.mypy_cache/

########################################
# ====== POSTGRESQL ======
########################################

# Local postgres dumps
*.dump
*.sql

########################################
# ====== NODE / ANGULAR ======
########################################

# Node modules
frontend/node_modules/

# Angular build output
frontend/dist/
frontend/.angular/
frontend/.cache/

# Angular environment files (optional si manejas secretos)
frontend/src/environments/*.prod.ts

# Package lock (decisión estratégica)
# Si es proyecto colaborativo -> NO ignorar
# package-lock.json

########################################
# ====== IDE ======
########################################

# VSCode
.vscode/

# PyCharm
.idea/

########################################
# ====== TYPESCRIPT ======
########################################

*.tsbuildinfo

########################################
# ====== TESTING ======
########################################

coverage/
